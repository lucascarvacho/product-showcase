{"ast":null,"code":"export default {\n  name: 'AppHeader',\n  data() {\n    return {\n      drawer: false\n    };\n  },\n  computed: {\n    esOscuro() {\n      return this.$vuetify.theme.global.name === 'dark';\n    }\n  },\n  methods: {\n    toggleTema() {\n      const nuevo = this.esOscuro ? 'light' : 'dark';\n      this.$vuetify.theme.global.name = nuevo;\n      localStorage.setItem('tema', nuevo);\n    }\n  },\n  created() {\n    const guardado = localStorage.getItem('tema');\n    if (guardado) this.$vuetify.theme.global.name = guardado;\n  }\n};","map":{"version":3,"names":["name","data","drawer","computed","esOscuro","$vuetify","theme","global","methods","toggleTema","nuevo","localStorage","setItem","created","guardado","getItem"],"sources":["C:\\Users\\lucas\\Desktop\\Product show case\\vue-product-showcase\\src\\components\\AppHeader.vue"],"sourcesContent":["<template>\n  <div>\n  <v-app-bar color=\"primary\" elevation=\"2\">\n    <v-btn icon variant=\"text\" class=\"d-flex d-md-none\" @click=\"drawer = !drawer\">\n      <span class=\"menu-icon\">☰</span>\n    </v-btn>\n\n    <v-img src=\"/images/logo.png\" alt=\"Product Show Case\" max-height=\"36\" max-width=\"36\" contain class=\"ml-2\"></v-img>\n    <v-app-bar-title class=\"ml-2\">Product Show Case</v-app-bar-title>\n\n    <v-spacer></v-spacer>\n\n    <div class=\"d-none d-md-flex\">\n      <v-btn to=\"/\" variant=\"text\">Home</v-btn>\n      <v-btn to=\"/catalogo\" variant=\"text\">Catálogo</v-btn>\n      <v-btn to=\"/favoritos\" variant=\"text\">Favoritos</v-btn>\n    </div>\n\n    <v-btn icon @click=\"toggleTema\" :title=\"esOscuro ? 'Cambiar a claro' : 'Cambiar a oscuro'\">\n      <img\n        :src=\"esOscuro ? '/images/tema-claro.png' : '/images/tema-oscuro.png'\"\n        width=\"24\"\n        height=\"24\"\n        alt=\"\"\n      />\n    </v-btn>\n  </v-app-bar>\n\n  <v-navigation-drawer v-model=\"drawer\" temporary>\n    <v-list>\n      <v-list-item to=\"/\" title=\"Home\" @click=\"drawer = false\"></v-list-item>\n      <v-list-item to=\"/catalogo\" title=\"Catálogo\" @click=\"drawer = false\"></v-list-item>\n      <v-list-item to=\"/favoritos\" title=\"Favoritos\" @click=\"drawer = false\"></v-list-item>\n    </v-list>\n  </v-navigation-drawer>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: 'AppHeader',\n  data() {\n    return { drawer: false }\n  },\n  computed: {\n    esOscuro() {\n      return this.$vuetify.theme.global.name === 'dark'\n    }\n  },\n  methods: {\n    toggleTema() {\n      const nuevo = this.esOscuro ? 'light' : 'dark'\n      this.$vuetify.theme.global.name = nuevo\n      localStorage.setItem('tema', nuevo)\n    }\n  },\n  created() {\n    const guardado = localStorage.getItem('tema')\n    if (guardado) this.$vuetify.theme.global.name = guardado\n  }\n}\n</script>\n\n<style scoped>\n.menu-icon { font-size: 1.5rem; line-height: 1; color: white; }\n</style>\n"],"mappings":"AAuCA,eAAe;EACbA,IAAI,EAAE,WAAW;EACjBC,IAAIA,CAAA,EAAG;IACL,OAAO;MAAEC,MAAM,EAAE;IAAM;EACzB,CAAC;EACDC,QAAQ,EAAE;IACRC,QAAQA,CAAA,EAAG;MACT,OAAO,IAAI,CAACC,QAAQ,CAACC,KAAK,CAACC,MAAM,CAACP,IAAG,KAAM,MAAK;IAClD;EACF,CAAC;EACDQ,OAAO,EAAE;IACPC,UAAUA,CAAA,EAAG;MACX,MAAMC,KAAI,GAAI,IAAI,CAACN,QAAO,GAAI,OAAM,GAAI,MAAK;MAC7C,IAAI,CAACC,QAAQ,CAACC,KAAK,CAACC,MAAM,CAACP,IAAG,GAAIU,KAAI;MACtCC,YAAY,CAACC,OAAO,CAAC,MAAM,EAAEF,KAAK;IACpC;EACF,CAAC;EACDG,OAAOA,CAAA,EAAG;IACR,MAAMC,QAAO,GAAIH,YAAY,CAACI,OAAO,CAAC,MAAM;IAC5C,IAAID,QAAQ,EAAE,IAAI,CAACT,QAAQ,CAACC,KAAK,CAACC,MAAM,CAACP,IAAG,GAAIc,QAAO;EACzD;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}