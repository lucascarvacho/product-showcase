{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { mapState, mapGetters, mapActions } from 'vuex';\nexport default {\n  name: 'ProductEditView',\n  props: {\n    id: {\n      type: [String, Number],\n      required: true\n    }\n  },\n  data() {\n    return {\n      formValido: false,\n      guardando: false,\n      error: false,\n      form: {\n        nombre: '',\n        marca: '',\n        categoria: '',\n        precio: null,\n        descripcion: '',\n        imagen: ''\n      },\n      reglas: {\n        requerido: v => v !== null && v !== '' || 'Campo obligatorio',\n        positivo: v => v > 0 || 'Debe ser mayor a 0'\n      }\n    };\n  },\n  computed: {\n    ...mapState('productos', ['cargando']),\n    ...mapGetters('productos', ['obtenerPorId']),\n    ...mapGetters('favoritos', ['esFavorito']),\n    producto() {\n      return this.obtenerPorId(this.id);\n    }\n  },\n  created() {\n    if (this.$store.state.productos.lista.length === 0) {\n      this.fetchProductos().then(this.cargarFormulario);\n    } else {\n      this.cargarFormulario();\n    }\n  },\n  methods: {\n    ...mapActions('productos', ['fetchProductos', 'editarProducto']),\n    ...mapActions('favoritos', ['toggleFavorito']),\n    cargarFormulario() {\n      if (!this.producto) return;\n      this.form = {\n        nombre: this.producto.nombre,\n        marca: this.producto.marca,\n        categoria: this.producto.categoria,\n        precio: this.producto.precio,\n        descripcion: this.producto.descripcion,\n        imagen: this.producto.imagen\n      };\n    },\n    cancelar() {\n      this.$router.push({\n        name: 'producto-detalle',\n        params: {\n          id: this.id\n        }\n      });\n    },\n    async guardar() {\n      const {\n        valid\n      } = await this.$refs.formulario.validate();\n      if (!valid) return;\n      this.guardando = true;\n      this.error = false;\n      try {\n        await this.editarProducto({\n          id: this.id,\n          producto: {\n            ...this.producto,\n            ...this.form\n          }\n        });\n        this.$router.push({\n          name: 'producto-detalle',\n          params: {\n            id: this.id\n          }\n        });\n      } catch (err) {\n        console.error('Error al editar producto:', err);\n        this.error = true;\n      } finally {\n        this.guardando = false;\n      }\n    }\n  }\n};","map":{"version":3,"names":["mapState","mapGetters","mapActions","name","props","id","type","String","Number","required","data","formValido","guardando","error","form","nombre","marca","categoria","precio","descripcion","imagen","reglas","requerido","v","positivo","computed","producto","obtenerPorId","created","$store","state","productos","lista","length","fetchProductos","then","cargarFormulario","methods","cancelar","$router","push","params","guardar","valid","$refs","formulario","validate","editarProducto","err","console"],"sources":["C:\\Users\\lucas\\Desktop\\Product show case\\vue-product-showcase\\src\\views\\ProductEditView.vue"],"sourcesContent":["<template>\n  <div>\n    <p v-if=\"cargando\">Cargando...</p>\n\n    <p v-else-if=\"!producto\">Producto no encontrado.</p>\n\n    <div v-else>\n      <h2 class=\"text-h5 mb-4\">Editar producto</h2>\n\n      <v-row>\n        <v-col cols=\"12\" sm=\"5\" md=\"4\">\n          <div class=\"position-relative\">\n            <v-img :src=\"form.imagen\" :alt=\"form.nombre\" rounded=\"lg\"></v-img>\n            <v-btn\n              class=\"editar-fav\"\n              icon\n              variant=\"tonal\"\n              @click=\"toggleFavorito(producto.id)\"\n            >\n              <img\n                :src=\"esFavorito(producto.id) ? '/images/favorito-activo.png' : '/images/favorito-inactivo.png'\"\n                width=\"22\"\n                height=\"22\"\n                alt=\"\"\n              />\n            </v-btn>\n          </div>\n        </v-col>\n\n        <v-col cols=\"12\" sm=\"7\" md=\"8\">\n          <v-form ref=\"formulario\" v-model=\"formValido\">\n            <v-text-field v-model=\"form.nombre\" label=\"Nombre\" :rules=\"[reglas.requerido]\"></v-text-field>\n            <v-text-field v-model=\"form.marca\" label=\"Marca\" :rules=\"[reglas.requerido]\"></v-text-field>\n            <v-text-field v-model=\"form.categoria\" label=\"Categoría\" :rules=\"[reglas.requerido]\"></v-text-field>\n            <v-text-field\n              v-model.number=\"form.precio\"\n              label=\"Precio\"\n              type=\"number\"\n              :rules=\"[reglas.requerido, reglas.positivo]\"\n            ></v-text-field>\n            <v-textarea v-model=\"form.descripcion\" label=\"Descripción\" rows=\"3\"></v-textarea>\n            <v-text-field v-model=\"form.imagen\" label=\"URL de la imagen\"></v-text-field>\n          </v-form>\n\n          <v-alert v-if=\"error\" type=\"error\" variant=\"tonal\" class=\"mb-4\">\n            No se pudo guardar el producto. Intenta de nuevo.\n          </v-alert>\n\n          <div class=\"d-flex ga-2\">\n            <v-btn color=\"primary\" variant=\"flat\" :loading=\"guardando\" @click=\"guardar\">Guardar</v-btn>\n            <v-btn variant=\"outlined\" :disabled=\"guardando\" @click=\"cancelar\">Cancelar</v-btn>\n          </div>\n        </v-col>\n      </v-row>\n    </div>\n  </div>\n</template>\n\n<script>\nimport { mapState, mapGetters, mapActions } from 'vuex'\n\nexport default {\n  name: 'ProductEditView',\n  props: {\n    id: { type: [String, Number], required: true }\n  },\n  data() {\n    return {\n      formValido: false,\n      guardando: false,\n      error: false,\n      form: { nombre: '', marca: '', categoria: '', precio: null, descripcion: '', imagen: '' },\n      reglas: {\n        requerido: (v) => (v !== null && v !== '') || 'Campo obligatorio',\n        positivo: (v) => v > 0 || 'Debe ser mayor a 0'\n      }\n    }\n  },\n  computed: {\n    ...mapState('productos', ['cargando']),\n    ...mapGetters('productos', ['obtenerPorId']),\n    ...mapGetters('favoritos', ['esFavorito']),\n    producto() {\n      return this.obtenerPorId(this.id)\n    }\n  },\n  created() {\n    if (this.$store.state.productos.lista.length === 0) {\n      this.fetchProductos().then(this.cargarFormulario)\n    } else {\n      this.cargarFormulario()\n    }\n  },\n  methods: {\n    ...mapActions('productos', ['fetchProductos', 'editarProducto']),\n    ...mapActions('favoritos', ['toggleFavorito']),\n    cargarFormulario() {\n      if (!this.producto) return\n      this.form = {\n        nombre: this.producto.nombre,\n        marca: this.producto.marca,\n        categoria: this.producto.categoria,\n        precio: this.producto.precio,\n        descripcion: this.producto.descripcion,\n        imagen: this.producto.imagen\n      }\n    },\n    cancelar() {\n      this.$router.push({ name: 'producto-detalle', params: { id: this.id } })\n    },\n    async guardar() {\n      const { valid } = await this.$refs.formulario.validate()\n      if (!valid) return\n\n      this.guardando = true\n      this.error = false\n      try {\n        await this.editarProducto({\n          id: this.id,\n          producto: { ...this.producto, ...this.form }\n        })\n        this.$router.push({ name: 'producto-detalle', params: { id: this.id } })\n      } catch (err) {\n        console.error('Error al editar producto:', err)\n        this.error = true\n      } finally {\n        this.guardando = false\n      }\n    }\n  }\n}\n</script>\n\n<style scoped>\n.editar-fav { position: absolute; bottom: 0.5rem; right: 0.5rem; }\n</style>\n"],"mappings":";AA2DA,SAASA,QAAQ,EAAEC,UAAU,EAAEC,UAAS,QAAS,MAAK;AAEtD,eAAe;EACbC,IAAI,EAAE,iBAAiB;EACvBC,KAAK,EAAE;IACLC,EAAE,EAAE;MAAEC,IAAI,EAAE,CAACC,MAAM,EAAEC,MAAM,CAAC;MAAEC,QAAQ,EAAE;IAAK;EAC/C,CAAC;EACDC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,UAAU,EAAE,KAAK;MACjBC,SAAS,EAAE,KAAK;MAChBC,KAAK,EAAE,KAAK;MACZC,IAAI,EAAE;QAAEC,MAAM,EAAE,EAAE;QAAEC,KAAK,EAAE,EAAE;QAAE