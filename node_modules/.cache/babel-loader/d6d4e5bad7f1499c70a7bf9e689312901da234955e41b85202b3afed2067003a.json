{"ast":null,"code":"import { mapState, mapGetters, mapActions } from 'vuex';\nimport ProductCard from '@/components/ProductCard.vue';\nimport CategoryFilter from '@/components/CategoryFilter.vue';\nexport default {\n  name: 'ProductList',\n  components: {\n    ProductCard,\n    CategoryFilter\n  },\n  computed: {\n    ...mapState('productos', ['cargando', 'error']),\n    ...mapGetters('productos', ['categoriasDisponibles', 'productosFiltrados']),\n    ...mapGetters('favoritos', ['esFavorito'])\n  },\n  created() {\n    this.fetchProductos();\n  },\n  methods: {\n    ...mapActions('productos', ['fetchProductos']),\n    ...mapActions('filtros', ['cambiarCategoria']),\n    ...mapActions('favoritos', ['toggleFavorito'])\n  }\n};","map":{"version":3,"names":["mapState","mapGetters","mapActions","ProductCard","CategoryFilter","name","components","computed","created","fetchProductos","methods"],"sources":["C:\\Users\\lucas\\Desktop\\Product show case\\vue-product-showcase\\src\\components\\ProductList.vue"],"sourcesContent":["<template>\n  <section>\n    <CategoryFilter :categorias=\"categoriasDisponibles\" @cambiar=\"cambiarCategoria\" />\n\n    <div v-if=\"cargando\" class=\"text-center py-8\">\n      <v-progress-circular indeterminate color=\"primary\"></v-progress-circular>\n      <p class=\"mt-2\">Cargando productos...</p>\n    </div>\n\n    <v-alert v-else-if=\"error\" type=\"error\" variant=\"tonal\" class=\"my-4\">\n      Ocurrió un error al cargar los productos.\n      <template v-slot:append>\n        <v-btn size=\"small\" variant=\"outlined\" @click=\"fetchProductos\">Reintentar</v-btn>\n      </template>\n    </v-alert>\n\n    <p v-else-if=\"productosFiltrados.length === 0\" class=\"text-center py-8 text-medium-emphasis\">\n      No hay productos para mostrar en esta categoría.\n    </p>\n\n    <v-row v-else>\n      <v-col\n        v-for=\"producto in productosFiltrados\"\n        :key=\"producto.id\"\n        cols=\"12\"\n        sm=\"6\"\n        md=\"4\"\n        lg=\"3\"\n      >\n        <ProductCard\n          :producto=\"producto\"\n          :es-favorito=\"esFavorito(producto.id)\"\n          @toggle-favorito=\"toggleFavorito\"\n        />\n      </v-col>\n    </v-row>\n  </section>\n</template>\n\n<script>\nimport { mapState, mapGetters, mapActions } from 'vuex'\nimport ProductCard from '@/components/ProductCard.vue'\nimport CategoryFilter from '@/components/CategoryFilter.vue'\n\nexport default {\n  name: 'ProductList',\n  components: { ProductCard, CategoryFilter },\n  computed: {\n    ...mapState('productos', ['cargando', 'error']),\n    ...mapGetters('productos', ['categoriasDisponibles', 'productosFiltrados']),\n    ...mapGetters('favoritos', ['esFavorito'])\n  },\n  created() {\n    this.fetchProductos()\n  },\n  methods: {\n    ...mapActions('productos', ['fetchProductos']),\n    ...mapActions('filtros', ['cambiarCategoria']),\n    ...mapActions('favoritos', ['toggleFavorito'])\n  }\n}\n</script>\n"],"mappings":"AAwCA,SAASA,QAAQ,EAAEC,UAAU,EAAEC,UAAS,QAAS,MAAK;AACtD,OAAOC,WAAU,MAAO,8BAA6B;AACrD,OAAOC,cAAa,MAAO,iCAAgC;AAE3D,eAAe;EACbC,IAAI,EAAE,aAAa;EACnBC,UAAU,EAAE;IAAEH,WAAW;IAAEC;EAAe,CAAC;EAC3CG,QAAQ,EAAE;IACR,GAAGP,QAAQ,CAAC,WAAW,EAAE,CAAC,UAAU,EAAE,OAAO,CAAC,CAAC;IAC/C,GAAGC,UAAU,CAAC,WAAW,EAAE,CAAC,uBAAuB,EAAE,oBAAoB,CAAC,CAAC;IAC3E,GAAGA,UAAU,CAAC,WAAW,EAAE,CAAC,YAAY,CAAC;EAC3C,CAAC;EACDO,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,cAAc,CAAC;EACtB,CAAC;EACDC,OAAO,EAAE;IACP,GAAGR,UAAU,CAAC,WAAW,EAAE,CAAC,gBAAgB,CAAC,CAAC;IAC9C,GAAGA,UAAU,CAAC,SAAS,EAAE,CAAC,kBAAkB,CAAC,CAAC;IAC9C,GAAGA,UAAU,CAAC,WAAW,EAAE,CAAC,gBAAgB,CAAC;EAC/C;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}