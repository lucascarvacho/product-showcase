{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { mapState, mapGetters, mapActions } from 'vuex';\nexport default {\n  name: 'ProductDetailView',\n  props: {\n    id: {\n      type: [String, Number],\n      required: true\n    }\n  },\n  computed: {\n    ...mapState('productos', ['cargando', 'error']),\n    ...mapGetters('productos', ['obtenerPorId']),\n    ...mapGetters('favoritos', ['esFavorito']),\n    producto() {\n      return this.obtenerPorId(this.id);\n    }\n  },\n  created() {\n    if (this.$store.state.productos.lista.length === 0) {\n      this.fetchProductos();\n    }\n  },\n  methods: {\n    ...mapActions('productos', ['fetchProductos', 'eliminarProducto']),\n    ...mapActions('favoritos', ['toggleFavorito']),\n    async onEliminar() {\n      if (confirm('¿Eliminar este producto?')) {\n        await this.eliminarProducto(this.producto.id);\n        this.$router.push('/catalogo');\n      }\n    }\n  }\n};","map":{"version":3,"names":["mapState","mapGetters","mapActions","name","props","id","type","String","Number","required","computed","producto","obtenerPorId","created","$store","state","productos","lista","length","fetchProductos","methods","onEliminar","confirm","eliminarProducto","$router","push"],"sources":["C:\\Users\\lucas\\Desktop\\Product show case\\vue-product-showcase\\src\\views\\ProductDetailView.vue"],"sourcesContent":["<template>\n  <div>\n    <v-btn to=\"/\" variant=\"text\" class=\"mb-4\">&larr; Volver</v-btn>\n\n    <div v-if=\"cargando\" class=\"text-center py-8\">\n      <v-progress-circular indeterminate color=\"primary\"></v-progress-circular>\n    </div>\n\n    <v-alert v-else-if=\"error\" type=\"error\" variant=\"tonal\">\n      No se pudo cargar el producto.\n      <template v-slot:append>\n        <v-btn size=\"small\" variant=\"outlined\" @click=\"fetchProductos\">Reintentar</v-btn>\n      </template>\n    </v-alert>\n\n    <v-row v-else-if=\"producto\">\n      <v-col cols=\"12\" sm=\"5\" md=\"4\">\n        <div class=\"position-relative\">\n          <v-img :src=\"producto.imagen\" :alt=\"producto.nombre\" rounded=\"lg\"></v-img>\n          <v-btn\n            class=\"detalle-fav\"\n            icon\n            variant=\"tonal\"\n            :color=\"esFavorito(producto.id) ? 'secondary' : undefined\"\n            @click=\"toggleFavorito(producto.id)\"\n          >\n            {{ esFavorito(producto.id) ? '★' : '☆' }}\n          </v-btn>\n        </div>\n      </v-col>\n\n      <v-col cols=\"12\" sm=\"7\" md=\"8\">\n        <h2 class=\"text-h5 mb-2\">{{ producto.nombre }}</h2>\n        <p><strong>Marca:</strong> {{ producto.marca }}</p>\n        <p><strong>Categoría:</strong> {{ producto.categoria }}</p>\n        <p><strong>Precio:</strong> ${{ producto.precio.toLocaleString('es-CL') }}</p>\n        <p><strong>Descripción:</strong> {{ producto.descripcion }}</p>\n\n        <div v-if=\"!producto.isDefault\" class=\"d-flex ga-2 mt-4\">\n          <v-btn color=\"primary\" :to=\"{ name: 'producto-editar', params: { id: producto.id } }\">\n            Editar\n          </v-btn>\n          <v-btn color=\"error\" variant=\"outlined\" @click=\"onEliminar\">Eliminar</v-btn>\n        </div>\n      </v-col>\n    </v-row>\n\n    <p v-else>Producto no encontrado.</p>\n  </div>\n</template>\n\n<script>\nimport { mapState, mapGetters, mapActions } from 'vuex'\n\nexport default {\n  name: 'ProductDetailView',\n  props: {\n    id: { type: [String, Number], required: true }\n  },\n  computed: {\n    ...mapState('productos', ['cargando', 'error']),\n    ...mapGetters('productos', ['obtenerPorId']),\n    ...mapGetters('favoritos', ['esFavorito']),\n    producto() {\n      return this.obtenerPorId(this.id)\n    }\n  },\n  created() {\n    if (this.$store.state.productos.lista.length === 0) {\n      this.fetchProductos()\n    }\n  },\n  methods: {\n    ...mapActions('productos', ['fetchProductos', 'eliminarProducto']),\n    ...mapActions('favoritos', ['toggleFavorito']),\n    async onEliminar() {\n      if (confirm('¿Eliminar este producto?')) {\n        await this.eliminarProducto(this.producto.id)\n        this.$router.push('/catalogo')\n      }\n    }\n  }\n}\n</script>\n\n<style scoped>\n.detalle-fav { position: absolute; bottom: 0.5rem; right: 0.5rem; }\n</style>\n"],"mappings":";AAoDA,SAASA,QAAQ,EAAEC,UAAU,EAAEC,UAAS,QAAS,MAAK;AAEtD,eAAe;EACbC,IAAI,EAAE,mBAAmB;EACzBC,KAAK,EAAE;IACLC,EAAE,EAAE;MAAEC,IAAI,EAAE,CAACC,MAAM,EAAEC,MAAM,CAAC;MAAEC,QAAQ,EAAE;IAAK;EAC/C,CAAC;EACDC,QAAQ,EAAE;IACR,GAAGV,QAAQ,CAAC,WAAW,EAAE,CAAC,UAAU,EAAE,OAAO,CAAC,CAAC;IAC/C,GAAGC,UAAU,CAAC,WAAW,EAAE,CAAC,cAAc,CAAC,CAAC;IAC5C,GAAGA,UAAU,CAAC,WAAW,EAAE,CAAC,YAAY,CAAC,CAAC;IAC1CU,QAAQA,CAAA,EAAG;MACT,OAAO,IAAI,CAACC,YAAY,CAAC,IAAI,CAACP,EAAE;IAClC;EACF,CAAC;EACDQ,OAAOA,CAAA,EAAG;IACR,IAAI,IAAI,CAACC,MAAM,CAACC,KAAK,CAACC,SAAS,CAACC,KAAK,CAACC,MAAK,KAAM,CAAC,EAAE;MAClD,IAAI,CAACC,cAAc,CAAC;IACtB;EACF,CAAC;EACDC,OAAO,EAAE;IACP,GAAGlB,UAAU,CAAC,WAAW,EAAE,CAAC,gBAAgB,EAAE,kBAAkB,CAAC,CAAC;IAClE,GAAGA,UAAU,CAAC,WAAW,EAAE,CAAC,gBAAgB,CAAC,CAAC;IAC9C,MAAMmB,UAAUA,CAAA,EAAG;MACjB,IAAIC,OAAO,CAAC,0BAA0B,CAAC,EAAE;QACvC,MAAM,IAAI,CAACC,gBAAgB,CAAC,IAAI,CAACZ,QAAQ,CAACN,EAAE;QAC5C,IAAI,CAACmB,OAAO,CAACC,IAAI,CAAC,WAAW;MAC/B;IACF;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}