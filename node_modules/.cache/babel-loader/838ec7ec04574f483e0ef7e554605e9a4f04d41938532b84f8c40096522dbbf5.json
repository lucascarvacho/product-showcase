{"ast":null,"code":"import \"core-js/modules/es.array.includes.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport { mapState, mapActions } from 'vuex';\nimport ProductCard from '@/components/ProductCard.vue';\nexport default {\n  name: 'FavoritosView',\n  components: {\n    ProductCard\n  },\n  computed: {\n    ...mapState('productos', ['lista', 'cargando']),\n    ...mapState('favoritos', {\n      idsFavoritos: 'ids'\n    }),\n    productosFavoritos() {\n      return this.lista.filter(p => this.idsFavoritos.includes(p.id));\n    }\n  },\n  created() {\n    if (this.lista.length === 0) this.fetchProductos();\n  },\n  methods: {\n    ...mapActions('productos', ['fetchProductos']),\n    ...mapActions('favoritos', ['toggleFavorito'])\n  }\n};","map":{"version":3,"names":["mapState","mapActions","ProductCard","name","components","computed","idsFavoritos","productosFavoritos","lista","filter","p","includes","id","created","length","fetchProductos","methods"],"sources":["C:\\Users\\lucas\\Desktop\\Product show case\\vue-product-showcase\\src\\views\\FavoritosView.vue"],"sourcesContent":["<template>\n  <div>\n    <h2 class=\"text-h5 mb-4\">Favoritos</h2>\n\n    <div v-if=\"cargando\" class=\"text-center py-8\">\n      <v-progress-circular indeterminate color=\"primary\"></v-progress-circular>\n    </div>\n\n    <p v-else-if=\"productosFavoritos.length === 0\" class=\"text-medium-emphasis\">\n      Aún no hay productos favoritos.\n    </p>\n\n    <v-row v-else>\n      <v-col v-for=\"producto in productosFavoritos\" :key=\"producto.id\" cols=\"12\" sm=\"6\" md=\"4\" lg=\"3\">\n        <ProductCard :producto=\"producto\" :es-favorito=\"true\" @toggle-favorito=\"toggleFavorito\" />\n      </v-col>\n    </v-row>\n  </div>\n</template>\n\n<script>\nimport { mapState, mapActions } from 'vuex'\nimport ProductCard from '@/components/ProductCard.vue'\n\nexport default {\n  name: 'FavoritosView',\n  components: { ProductCard },\n  computed: {\n    ...mapState('productos', ['lista', 'cargando']),\n    ...mapState('favoritos', { idsFavoritos: 'ids' }),\n    productosFavoritos() {\n      return this.lista.filter((p) => this.idsFavoritos.includes(p.id))\n    }\n  },\n  created() {\n    if (this.lista.length === 0) this.fetchProductos()\n  },\n  methods: {\n    ...mapActions('productos', ['fetchProductos']),\n    ...mapActions('favoritos', ['toggleFavorito'])\n  }\n}\n</script>\n"],"mappings":";;;AAqBA,SAASA,QAAQ,EAAEC,UAAS,QAAS,MAAK;AAC1C,OAAOC,WAAU,MAAO,8BAA6B;AAErD,eAAe;EACbC,IAAI,EAAE,eAAe;EACrBC,UAAU,EAAE;IAAEF;EAAY,CAAC;EAC3BG,QAAQ,EAAE;IACR,GAAGL,QAAQ,CAAC,WAAW,EAAE,CAAC,OAAO,EAAE,UAAU,CAAC,CAAC;IAC/C,GAAGA,QAAQ,CAAC,WAAW,EAAE;MAAEM,YAAY,EAAE;IAAM,CAAC,CAAC;IACjDC,kBAAkBA,CAAA,EAAG;MACnB,OAAO,IAAI,CAACC,KAAK,CAACC,MAAM,CAAEC,CAAC,IAAK,IAAI,CAACJ,YAAY,CAACK,QAAQ,CAACD,CAAC,CAACE,EAAE,CAAC;IAClE;EACF,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,IAAI,CAACL,KAAK,CAACM,MAAK,KAAM,CAAC,EAAE,IAAI,CAACC,cAAc,CAAC;EACnD,CAAC;EACDC,OAAO,EAAE;IACP,GAAGf,UAAU,CAAC,WAAW,EAAE,CAAC,gBAAgB,CAAC,CAAC;IAC9C,GAAGA,UAAU,CAAC,WAAW,EAAE,CAAC,gBAAgB,CAAC;EAC/C;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}